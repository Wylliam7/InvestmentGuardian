# --- Secrets et identifiants (ne jamais versionner) ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
credentials
.aws/
aws_credentials*
secrets*
*.secret

# --- Environnements et caches Python ---
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
*.egg-info/
build/
dist/

# --- Données officielles : seuls les trois CSV autorisés sont versionnés ---
Datathon2026/*
!Datathon2026/alphaforge_starter/
Datathon2026/alphaforge_starter/*
data/raw/
*.csv
!config/*.csv
!Datathon2026/alphaforge_starter/assets_universe.csv
!Datathon2026/alphaforge_starter/prices_daily.csv
!Datathon2026/alphaforge_starter/fx_usdcad_daily.csv

# --- Fichiers de travail locaux ---
scratch/
tmp/
*.log
.DS_Store
.streamlit/secrets.toml

# --- Traces : seules les traces réelles revues manuellement sont ajoutées avec git add -f ---
traces/*
!traces/.gitkeep
